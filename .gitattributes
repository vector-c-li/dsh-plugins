# Normalise line endings so a Windows checkout and a macOS checkout produce the
# same diff.
* text=auto eol=lf

# Keep binaries untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.woff binary
*.woff2 binary

# PowerShell scripts may legitimately carry CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
