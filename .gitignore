# Ignore everywhere
node_modules/
*.log
.DS_Store
Thumbs.db

# DSH runtime bits that must never be committed
.credentials.yaml
*.credentials.yaml
.dsh/
cache/
data/

# Local dev leftovers and scratch files (never in a commit, never in history)
.tmp-*/
tmp/
*.local.*
preview.log
preview.err
*.tmp
.commit-msg
.commitmsg.tmp
.research/
state/
dist/

# The vendor proof-of-work module is downloaded, not distributed.
# Get it with: node plugins/deepseek-web-chat/scripts/fetch-wasm.mjs
*.wasm
